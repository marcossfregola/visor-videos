config_version: 1
control_plane:
  base_url: "https://api.openai.com"
  tunnel_id: "__TUNNEL_ID__"
  api_key: "env:CONTROL_PLANE_API_KEY"
health:
  listen_addr: "127.0.0.1:8787"
  url_file: "%LOCALAPPDATA%/ChatGPTOpenCodeBridge/tunnel-client/health.url"
admin_ui:
  open_browser: false
log:
  level: info
  format: json
  file: "%LOCALAPPDATA%/ChatGPTOpenCodeBridge/logs/tunnel-client.log"
mcp:
  commands:
    - channel: main
      command: "%LOCALAPPDATA%/ChatGPTOpenCodeBridge/mcp/venv/Scripts/python.exe -u %LOCALAPPDATA%/ChatGPTOpenCodeBridge/mcp/mcp-server.py"
